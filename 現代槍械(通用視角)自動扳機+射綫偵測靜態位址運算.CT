            </CheatEntry>
            <CheatEntry>
              <ID>1807637582</ID>
              <Description>"自動瞄準運算角度+自動扳機(开启顺序:静默+整理射线,自动计算,自动扳机)"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$Lua}
if syntaxcheck then return end

[ENABLE]
if _aim_index == nil then
  _aim_index = 1
end

-- 分開的Yaw和Pitch地址
LeftsuperLuaAutoClickForTriggerbot_thread = createNativeThread(function (thread)
  thread.freeOnTerminate(false)
  thread.Name = 'Aimbot_thread'

  -- 緩存玩家信息，減少重複讀取
  local cachedSelfFaction = nil
  local cachedPlayerX, cachedPlayerY, cachedPlayerZ = nil, nil, nil
  local lastCacheUpdate = 0

  -- 緩存敵人列表，減少讀取
  local cachedPlayerList = nil
  local cachedEnemyCount = nil

  while not thread.Terminated do
    -- 獲取敵人數量（緩存優化）
    local enemyCount = readInteger("[libSandboxEngine.dll+1AD1800]+8")

    -- 檢查是否有有效敵人
    if enemyCount and enemyCount &gt; 1 then
      -- 定期更新緩存（每100ms）
      local currentTime = getTickCount()
      if currentTime - lastCacheUpdate &gt; 1 then
        -- 更新玩家陣營緩存
        local SelfCampPtr = readQword("[[libSandboxGame.dll+3E09C08]+1A0]+340")
        if SelfCampPtr and SelfCampPtr ~= 0 then
          cachedSelfFaction = readInteger(SelfCampPtr + 0x38) or 0
        else
          cachedSelfFaction = 0
        end

        -- 更新玩家位置緩存（直接讀取有符號整數）
        local playerBase = readQword("[libEngine.dll+172E540]+58")
        local suoyinduiqi = readInteger("[[[[libMiniBlock.dll+1E6FD0]+190]+10]+108]+40")
        local zijisuoyin = suoyinduiqi * 48

        if playerBase then
          cachedPlayerX = readFloat(playerBase + zijisuoyin + 0x0) or 0
          cachedPlayerY = readFloat(playerBase + zijisuoyin + 0x4) or 0
          cachedPlayerZ = readFloat(playerBase + zijisuoyin + 0x8) or 0
        end

        -- 更新敵人列表緩存
        cachedPlayerList = readQword("[[[[[libSandboxEngine.dll+1C3FE30]+240]+0]+28]+1F0]+38")
        cachedEnemyCount = enemyCount

        lastCacheUpdate = currentTime
      end

      -- 檢查緩存是否有效
      if cachedPlayerList and cachedPlayerList ~= 0 then
        local foundValidEnemy = false

        -- 嘗試尋找有效敵人（最多嘗試5個）
        local attempts = 0
        local maxCount = readInteger("[libSandboxEngine.dll+1AD1800]+8")
        local maxAttempts = math.min(enemyCount, maxCount)

        while not foundValidEnemy and attempts &lt; maxAttempts and not thread.Terminated do
          local enemyInstance = readQword(cachedPlayerList + _aim_index * 8)

          if enemyInstance and enemyInstance ~= 0 then
            -- 血量判斷
            local EnemyHPPtr = readQword(enemyInstance + 0x220)
            local EnemyHP = 100.0

            if EnemyHPPtr and EnemyHPPtr ~= 0 then
              EnemyHP = readFloat(EnemyHPPtr + 0x38) or 100.0
            end

            if EnemyHP &gt; 0.00 then
              -- 陣營判斷
              local EnemyCampPtr = readQword(enemyInstance + 0x340)
              local EnemyFaction = 0

              if EnemyCampPtr and EnemyCampPtr ~= 0 then
                EnemyFaction = readInteger(EnemyCampPtr + 0x38) or 0
              end

              local shouldAim = false

              if cachedSelfFaction == 0 then
                shouldAim = true
              elseif EnemyFaction ~= cachedSelfFaction then
                shouldAim = true
              end

              -- 直接用坐标和距离算 (a, b, c)
              if shouldAim then
                local locationPtr = readQword(enemyInstance + 0x150)

                if locationPtr and locationPtr ~= 0 then
                  -- 直接讀取有符號整數
                  local enemyX = readInteger(locationPtr + 0x2C8, true) or 0
                  local enemyYY = readInteger(locationPtr + 0x2CC, true) or 0
                  local enemyY = enemyYY + 152
                  local enemyZ = readInteger(locationPtr + 0x2D0, true) or 0

                  -- 使用緩存的玩家位置
                  if cachedPlayerX and cachedPlayerY and cachedPlayerZ then
                    -- 計算相對位置
                    local dx = enemyX - cachedPlayerX
                    local dy = enemyY - cachedPlayerY
                    local dz = enemyZ - cachedPlayerZ

                    -- 計算總距離
                    local dist = math.sqrt(dx*dx + dy*dy + dz*dz)

                    -- 直接算 (a, b, c)
                    local a = dx / dist
                    local b = dy / dist
                    local c = dz / dist

                    -- 寫入三組值
                    writeFloat("Xzhou", a)
                    writeFloat("Yzhou", b)
                    writeFloat("Zzhou", c)
                    writeFloat("angle1", a)
                    writeFloat("angle2", b)
                    writeFloat("angle3", c)
--                    local wall = readInteger("[libSandboxGame.dll+3E09C08]+88")
--                    local myHP = readFloat("[[[libSandboxGame.dll+3E09C08]+1A0]+220]+38")
--                    if wall == 2
--                    then
--                    if myHP &gt; 0.00
--                    then
--                    autoAssemble("createthread(Fire)")
--                    sleep(40)
--                    end
--                    end
                    foundValidEnemy = true
                  end
                end
              end
            end
          end

          -- 切換到下一個目標
          _aim_index = _aim_index + 1
          if _aim_index &gt;= cachedEnemyCount then
            _aim_index = 1
          end
                    sleep(5)
          attempts = attempts + 1
        end
      end
    end
  end
end)

[DISABLE]
if LeftsuperLuaAutoClickForTriggerbot_thread then
  LeftsuperLuaAutoClickForTriggerbot_thread.terminate()
  LeftsuperLuaAutoClickForTriggerbot_thread.waitfor()
  LeftsuperLuaAutoClickForTriggerbot_thread.destroy()
  LeftsuperLuaAutoClickForTriggerbot_thread = nil
  _aim_index = nil
end
</AssemblerScript>
