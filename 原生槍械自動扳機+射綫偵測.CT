        <CheatEntry>
          <ID>1807689770</ID>
          <Description>"整理射綫距離與方向"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
alloc(newmem,2048,"libSandboxEngine.dll"+822D24) 
label(returnhere)
label(originalcode)
label(exit)
alloc(Xzhou,8)
registersymbol(Xzhou)
alloc(Yzhou,8)
registersymbol(Yzhou)
alloc(Zzhou,8)
registersymbol(Zzhou)
newmem:
originalcode:
PUSH RAX
PUSH RBX
PUSH RCX
mov rax,[Xzhou]
mov rbx,[Yzhou]
mov rcx,[Zzhou]
mov [rbp-05],RAX//X轴矩阵角
mov [rbp-01],RBX//Y轴矩阵角
mov [rbp+03],RCX//Z轴矩阵角
mov [rbp+07],4CABA950//距离
POP RCX
POP RBX
POP RAX
movss xmm3,[rbp+07]
exit:
jmp returnhere
"libSandboxEngine.dll"+822D24:
jmp newmem
returnhere:
[DISABLE]
unregistersymbol(Xzhou)
dealloc(Xzhou)
unregistersymbol(Yzhou)
dealloc(Yzhou)
unregistersymbol(Zzhou)
dealloc(Zzhou)
dealloc(newmem)
"libSandboxEngine.dll"+822D24:
db F3 0F 10 5D 07
//movss xmm3,[rbp+07]
</AssemblerScript>
