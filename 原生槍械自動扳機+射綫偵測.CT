            <CheatEntry>
              <ID>1807689774</ID>
              <Description>"更優的自動扳機(判断队友)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
alloc(newmem,2048,"libSandboxEngine.dll"+822ED7) 
label(returnhere)
label(originalcode)
label(exit)
newmem:
originalcode:
cmp rax,2
jne tuichu
push rax
push rbx
push rcx
push rdx
push r8
push r9
push r10
push r11
push rdi
lea rsp,[rsp-28]
mov edx,1
MOV RBX,libSandboxGame.dll+3E09C08
MOV RBX,[RBX]
MOV RBX,[RBX+1A0]
mov rcx,[rbx+EB8]
cmp [rcx+38],0
je fangbeng
MOV RBX,libSandboxGame.dll+3E09C08
MOV RBX,[RBX]
MOV RBX,[RBX+1A0]
mov rbx,[rbx+720]
cmp rbx,0
je fangbeng
MOV r11,libSandboxGame.dll+3E09C08
MOV r11,[r11]
MOV r11,[r11+1A0]
mov r11,[r11+340]
mov r11,[r11+38]//自己
mov rbx,[rbx+340]
cmp  dword ptr [rbx+38],r11d
je fangbeng//当自己和射线检测函数的阵营值相同时候跳过,也把自己与别人为0的时候也跳过开枪
xor edx,edx
mov rdi,libSandboxGame.dll+3E09C08
mov rdi,[rdi]
mov rdi,[rdi+1A0]
mov rdi,[rdi+EB8]
mov rcx,rdi
call libSandboxGame.dll+23DC7E0
fangbeng:
lea rsp,[rsp+28]
pop rdi
pop r11
pop r10
pop r9
pop r8
pop rdx
pop rcx
pop rbx
pop rax
tuichu:
lea r11,[rsp+000000A0]
exit:
jmp returnhere
"libSandboxEngine.dll"+822ED7:
jmp newmem
nop 3
returnhere:
[DISABLE]
dealloc(newmem)
"libSandboxEngine.dll"+822ED7:
db 4C 8D 9C 24 A0 00 00 00
//lea r11,[rsp+000000A0]
